{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plot",
  "version": "0.9.0",
  "identifier": "app.getplot.plot",
  "build": {
    "beforeBuildCommand": "npm run web:export",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Plot",
        "width": 440,
        "height": 900,
        "minWidth": 380,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0E0E10"
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Embedder-Policy": "credentialless",
        "Cross-Origin-Opener-Policy": "same-origin"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "ADHD dostu günlük planlama",
    "longDescription": "Plot; bugünün üç must-do işini, notları ve odak oturumlarını tek yerde toplayan ADHD dostu bir günlük planlama uygulaması.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDNUE0NUYwQzU0MTRGNkUKUldSdVQwSEY4RVZhYklSMHVSaFJFc0JJYXR5Y012aXV1NEluNGRDZjZIcU92OGUyRlNpUFpqaFQK",
      "endpoints": [
        "https://github.com/Flynntaggart26/plot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
